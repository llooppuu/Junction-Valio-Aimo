# Copy this file to .env in the repository root.

# Valio Aimo's mock price and availability APIs, from the Junction platform. The key stays on the server.
# Without it the catalog can be searched, but nothing can be priced, quoted, or ordered.
VALIO_API_KEY=
VALIO_API_URL=https://junction26.valioaimo.fi

# Port for the Express API. The Vite proxy reads the same value, so both stay in sync.
BACKEND_PORT=3001

# Demo credentials (at least 8 characters). The AI agent sends AGENT_TOKEN.
# The Vite proxy adds BUYER_TOKEN to every request from the frontend.
AGENT_TOKEN=demo-agent-token
BUYER_TOKEN=demo-buyer-token
# The school kitchen's agent, which has strict allergen and nutrition rules.
SCHOOL_AGENT_TOKEN=demo-school-agent-token
# The wholesaler's operations team. The Vite proxy adds it to /api/wholesaler requests.
WHOLESALER_TOKEN=demo-wholesaler-token

# The AI purchasing agent. Without a key the agent is off and everything else still works.
# The key stays on the server and is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# minimal, low, medium, or high. Low keeps a demo run to about 10 seconds.
OPENAI_REASONING_EFFORT=low

# Voice input in the agent workspace, through Gemini Live. Without a key the microphone button is hidden.
# The key stays on the server: the browser gets a single-use token for each request it dictates.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# Production hosting. The Docker image sets both, so leave them unset for local development.
# PORT: the port to listen on, which most hosting platforms provide. It wins over BACKEND_PORT.
# FRONTEND_DIST: the built frontend; when set, the backend serves it and adds the demo tokens itself.
# PORT=8080
# FRONTEND_DIST=frontend/dist
