{
  "name": "@trusted-trade-agents/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:adversarial": "node --import tsx --test test/adversarial.test.ts",
    "data": "node --max-old-space-size=4096 --import tsx scripts/build-catalog.ts",
    "record-fixture": "node --import tsx scripts/record-fixture.ts",
    "find-products": "node --import tsx scripts/find-products.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "embeddings": "node --import tsx scripts/build-embeddings.ts",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "openai": "^7.53.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
